<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vulcano.App.Controls"
             xmlns:vm="clr-namespace:Vulcano.App.ViewModels"
             x:Class="Vulcano.App.Views.CompactView"
             x:DataType="vm:ShellViewModel">

  <Grid RowDefinitions="26,*" Background="{DynamicResource Bg.App}">

    <!-- ============ Title bar · 26 ============ -->
    <Border Grid.Row="0"
            Name="CompactTitleBar"
            Background="{DynamicResource Bg.Chrome}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Image Grid.Column="0" Width="11" Height="11" Margin="9,0,7,0"
               Source="avares://vulcano-control/Assets/Icons/vulcano-control-16.png" />
        <TextBlock Grid.Column="1" Text="{DynamicResource S.Compact.Title}" FontSize="10.5"
                   Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center" />

        <!-- No room for the full chip in a 26 px bar, but the warning has to survive the switch to
             compact - that is the mode most likely to be left running unattended. -->
        <TextBlock Grid.Column="2" Text="{DynamicResource S.Simulation.Short}"
                   Margin="7,0,0,0" FontSize="9.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Warn}" VerticalAlignment="Center"
                   IsVisible="{Binding IsSimulated}"
                   ToolTip.Tip="{DynamicResource S.Simulation.Tip}" />

        <!-- Always on top, here as well as in the full window: this is the mode it is actually
             wanted in - a small window parked over something else while a ramp runs - and having to
             switch it on beforehand meant leaving compact to change your mind. -->
        <ToggleButton Grid.Column="3" Theme="{StaticResource CompactWindowToggle}"
                      IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                      ToolTip.Tip="{DynamicResource S.Action.AlwaysOnTop}">
          <c:Icon Data="{StaticResource Icon.Pin}" Width="11" Height="11" />
        </ToggleButton>

        <!-- Same button as in the full window's title bar, pointing the other way. -->
        <Button Grid.Column="4" Theme="{StaticResource CompactWindowButton}"
                Command="{Binding ToggleCompactCommand}"
                ToolTip.Tip="{DynamicResource S.Compact.BackToFull}">
          <c:Icon Data="{StaticResource Icon.Maximize2}" Width="11" Height="11" />
        </Button>
        <Button Grid.Column="5" Theme="{StaticResource CompactWindowButton}" Classes="close"
                Click="OnCloseClick">
          <c:Icon Data="{StaticResource Icon.X}" Width="11" Height="11" />
        </Button>
      </Grid>
    </Border>

    <!-- ============ Content ============
         The temperature column is Auto and comes first, so it is measured before anything else and
         cannot be squeezed: it is the reason this window exists, and a reading clipped to its first
         digit is worse than no reading at all - 185 that renders as 1 is not obviously wrong.
         Whatever is short of room, it is the buttons, and they are 34 px squares with tooltips. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="14,4,12,6">

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <TextBlock Text="{Binding Control.CurrentTemperatureText}"
                     FontFamily="{StaticResource Font.Mono}"
                     FontSize="{StaticResource Text.DisplayRemote}"
                     FontWeight="Medium"
                     LineHeight="54"
                     Foreground="{DynamicResource Text}" />
          <TextBlock Text="°C"
                     FontFamily="{StaticResource Font.Mono}"
                     FontSize="13"
                     Foreground="{DynamicResource Text.Dim}"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,7" />
        </StackPanel>

        <!-- Trimmed rather than allowed to widen the column: the plan and the time left are worth
             showing, but not at the price of the number above them. -->
        <TextBlock Text="{Binding CompactDetailText}" Classes="mono footnote"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
        <ToggleButton Theme="{StaticResource CompactTile}"
                      Classes="heat"
                      IsChecked="{Binding Control.HeaterSwitchOn}"
                      IsEnabled="{Binding IsConnected}"
                      ToolTip.Tip="{DynamicResource S.Control.Heater}">
          <c:Icon Data="{StaticResource Icon.Flame}" Width="17" Height="17" />
        </ToggleButton>

        <ToggleButton Theme="{StaticResource CompactTile}"
                      IsChecked="{Binding Control.PumpSwitchOn}"
                      IsEnabled="{Binding IsConnected}"
                      ToolTip.Tip="{DynamicResource S.Control.Pump}">
          <c:Icon Data="{StaticResource Icon.Fan}" Width="17" Height="17" />
        </ToggleButton>

        <!-- Only there while there is a ramp to stop. -->
        <Button Theme="{StaticResource CompactButton}"
                Command="{Binding Run.StopRampCommand}"
                IsVisible="{Binding IsRampRunning}"
                ToolTip.Tip="{DynamicResource S.Action.StopRamp}">
          <c:Icon Data="{StaticResource Icon.Square}" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>

</UserControl>
