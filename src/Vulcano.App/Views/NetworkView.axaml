<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vulcano.App.ViewModels"
             x:Class="Vulcano.App.Views.NetworkView"
             x:DataType="vm:NetworkViewModel">

  <ScrollViewer>
    <Grid ColumnDefinitions="*,16,*" Margin="14">

      <!-- ============ Hosting ============ -->
      <StackPanel Grid.Column="0" Spacing="12">
        <TextBlock Text="{DynamicResource S.Network.Share.Title}" FontSize="{StaticResource Text.Section}" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource S.Network.Share.Hint}"
                   Classes="sub" TextWrapping="Wrap" />

        <Border Classes="card" IsEnabled="{Binding CanHost}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="{DynamicResource S.Network.Sharing}" />
              <Border Grid.Column="1" Classes="chip success" IsVisible="{Binding IsHosting}">
                <TextBlock Text="{DynamicResource S.Network.Hosting}" />
              </Border>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource S.Network.ThisMachine}" Classes="sub" />
              <TextBlock Text="{Binding HostAddressText}" Classes="value" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="{DynamicResource S.Network.Port}" Classes="sub" />
                <TextBox Text="{Binding Port, Mode=TwoWay}" FontFamily="{StaticResource Font.Mono}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="{DynamicResource S.Network.Pin}" Classes="sub" />
                <Grid ColumnDefinitions="*,6,Auto">
                  <TextBox Grid.Column="0" Text="{Binding Pin, Mode=TwoWay}"
                           FontFamily="{StaticResource Font.Mono}" />
                  <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}"
                          Content="{DynamicResource S.Action.New}" Command="{Binding NewPinCommand}" />
                </Grid>
              </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource S.Network.Pin.Hint}"
                       Classes="footnote" TextWrapping="Wrap" />

            <Border Classes="row last">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{DynamicResource S.Network.HostOnStart}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Theme="{StaticResource Toggle}"
                              IsChecked="{Binding HostOnStart, Mode=TwoWay}" />
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Theme="{StaticResource PrimaryButton}"
                      Content="{DynamicResource S.Action.StartHosting}"
                      Command="{Binding StartHostingCommand}"
                      IsVisible="{Binding !IsHosting}" />
              <Button Theme="{StaticResource SecondaryButton}"
                      Content="{DynamicResource S.Action.StopHosting}"
                      Command="{Binding StopHostingCommand}"
                      IsVisible="{Binding IsHosting}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsHosting}">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="{Binding ClientsTitle}" />

            <ItemsControl ItemsSource="{Binding Clients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectedClientRow">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,9,0"
                               VerticalAlignment="Center" Fill="{DynamicResource Success}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Classes="footnote" />
                      </StackPanel>
                      <Border Grid.Column="2" Classes="chip" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Role}" />
                      </Border>
                      <Button Grid.Column="3" Theme="{StaticResource SecondaryButton}"
                              Content="{DynamicResource S.Action.Revoke}"
                              Command="{Binding $parent[ItemsControl].((vm:NetworkViewModel)DataContext).RevokeCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{DynamicResource S.Network.Clients.Empty}"
                       Classes="sub"
                       IsVisible="{Binding !HasClients}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ============ Joining ============ -->
      <StackPanel Grid.Column="2" Spacing="12">
        <TextBlock Text="{DynamicResource S.Network.Join.Title}" FontSize="{StaticResource Text.Section}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource S.Network.Join.Hint}"
                   Classes="sub" TextWrapping="Wrap" />

        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="label" Text="{DynamicResource S.Network.Join}" />

            <StackPanel Spacing="5">
              <TextBlock Text="{DynamicResource S.Network.Join.Address}" Classes="sub" />
              <TextBox Text="{Binding JoinAddress, Mode=TwoWay}"
                       Watermark="192.168.1.42"
                       FontFamily="{StaticResource Font.Mono}"
                       IsEnabled="{Binding !IsRemote}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="{DynamicResource S.Network.Port}" Classes="sub" />
                <TextBox Text="{Binding JoinPort, Mode=TwoWay}"
                         FontFamily="{StaticResource Font.Mono}"
                         IsEnabled="{Binding !IsRemote}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="{DynamicResource S.Network.Pin}" Classes="sub" />
                <TextBox Text="{Binding JoinPin, Mode=TwoWay}"
                         FontFamily="{StaticResource Font.Mono}"
                         Classes.invalid="{Binding JoinError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         IsEnabled="{Binding !IsRemote}" />
              </StackPanel>
            </Grid>

            <Border Classes="row last">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{DynamicResource S.Network.Join.WatchOnly}" />
                  <!-- Says plainly what it is: the host refuses writes from a watcher, but the PIN
                       is still the only gate. -->
                  <TextBlock Text="{DynamicResource S.Network.Join.WatchOnly.Hint}"
                             Classes="footnote" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Theme="{StaticResource Toggle}"
                              IsChecked="{Binding JoinAsWatcher, Mode=TwoWay}"
                              IsEnabled="{Binding !IsRemote}" />
              </Grid>
            </Border>

            <TextBlock Text="{Binding JoinError}" Classes="error"
                       IsVisible="{Binding JoinError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Theme="{StaticResource PrimaryButton}"
                      Content="{DynamicResource S.Action.Connect}"
                      Command="{Binding JoinCommand}"
                      IsVisible="{Binding !IsRemote}"
                      IsEnabled="{Binding !IsJoining}" />
              <Button Theme="{StaticResource SecondaryButton}"
                      Content="{DynamicResource S.Action.Leave}"
                      Command="{Binding LeaveCommand}"
                      IsVisible="{Binding IsRemote}" />
            </StackPanel>

            <Border Classes="card tight" Background="{DynamicResource Surface.Info}"
                    BorderThickness="0"
                    IsVisible="{Binding IsRemote}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding RemoteBanner}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Info}"
                           FontSize="{StaticResource Text.Small}" />

                <!-- Timed against a reply the host sends without touching the Volcano, so this is
                     the network between the two machines and nothing else. -->
                <TextBlock Text="{Binding LatencyText}" Classes="mono footnote"
                           IsVisible="{Binding IsLatencyVisible}" />

                <TextBlock Text="{DynamicResource S.Network.Latency.Slow}"
                           Classes="footnote warn" TextWrapping="Wrap"
                           IsVisible="{Binding IsLatencySlow}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource S.Network.Firewall.Hint}"
                   Classes="footnote" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </ScrollViewer>

</UserControl>
