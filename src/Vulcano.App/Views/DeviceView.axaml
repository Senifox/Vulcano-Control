<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vulcano.App.Controls"
             xmlns:vm="clr-namespace:Vulcano.App.ViewModels"
             x:Class="Vulcano.App.Views.DeviceView"
             x:DataType="vm:DeviceViewModel">

  <Grid ColumnDefinitions="440,*" Margin="14">
    <StackPanel Grid.Column="0" Spacing="12">

      <TextBlock Text="{DynamicResource S.Device.Title}" FontSize="{StaticResource Text.Section}" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource S.Device.Hint}"
                 Classes="sub" TextWrapping="Wrap" />

      <!-- ============ Identity ============ -->
      <Border Classes="card"
              BorderBrush="{DynamicResource Border.Dashed}"
              Opacity="{Binding IsRemote, Converter={StaticResource DimWhenTrue}}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="label" Text="{DynamicResource S.Device.Identity}" />
            <Border Grid.Column="1" Classes="chip info" IsVisible="{Binding IsRemote}">
              <TextBlock Text="{Binding RemoteNote}" />
            </Border>
          </Grid>

          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Device.Serial}" Classes="sub" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SerialNumber}" Classes="value" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Device.HoursOfHeating}" Classes="sub" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HoursOfHeating}" Classes="value" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.Device.Firmware}" Classes="sub" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareVersion}" Classes="value" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource S.Device.BleFirmware}" Classes="sub" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BleFirmwareVersion}" Classes="value" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ Device settings ============ -->
      <Border Classes="card" IsEnabled="{Binding IsConnected}">
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource S.Device.DisplayAndTimers}" Margin="0,0,0,6" />

          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{DynamicResource S.Device.Brightness}" />
                <TextBlock Text="{DynamicResource S.Device.Brightness.Hint}" Classes="footnote" />
              </StackPanel>
              <c:Stepper Grid.Column="1"
                         Value="{Binding Brightness, Mode=TwoWay}"
                         Minimum="0" Maximum="100" Step="5" Unit="%" Width="130" />
            </Grid>
          </Border>

          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{DynamicResource S.Device.AutoOff}" />
                <TextBlock Text="{DynamicResource S.Device.AutoOff.Hint}" Classes="footnote" />
              </StackPanel>
              <c:Stepper Grid.Column="1"
                         Value="{Binding AutoOffMinutes, Mode=TwoWay}"
                         Minimum="5" Maximum="360" Step="5" Unit="min" Width="130" />
            </Grid>
          </Border>

          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{DynamicResource S.Device.Vibration}" />
                <TextBlock Text="{DynamicResource S.Device.Vibration.Hint}" Classes="footnote" />
              </StackPanel>
              <ToggleButton Grid.Column="1" Theme="{StaticResource Toggle}"
                            IsChecked="{Binding Vibration, Mode=TwoWay}" />
            </Grid>
          </Border>

          <Border Classes="row last">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{DynamicResource S.Device.ShowTempWhileCooling}" />
                <TextBlock Text="{DynamicResource S.Device.ShowTempWhileCooling.Hint}" Classes="footnote" />
              </StackPanel>
              <ToggleButton Grid.Column="1" Theme="{StaticResource Toggle}"
                            IsChecked="{Binding ShowTemperatureWhileCooling, Mode=TwoWay}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Theme="{StaticResource SecondaryButton}"
                Content="{DynamicResource S.Action.ReloadFromDevice}"
                Command="{Binding ReloadCommand}"
                IsEnabled="{Binding IsConnected}" />
      </StackPanel>

      <TextBlock Text="{DynamicResource S.Device.UnitDeferred}"
                 Classes="footnote" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>

</UserControl>
