<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vulcano.App.Controls"
             xmlns:vm="clr-namespace:Vulcano.App.ViewModels"
             xmlns:models="clr-namespace:Vulcano.Core.Models;assembly=Vulcano.Core"
             x:Class="Vulcano.App.Views.RampView"
             x:DataType="vm:RampViewModel">

  <Grid RowDefinitions="Auto,290,Auto,*" Margin="14">

    <!-- ============ Header ============
         Pick a profile, rename it in the box beside it, add one, throw one away. The name is part of
         what Save writes, so there is no separate rename step and no way to end up with a renamed
         profile whose points were never saved. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0"
                 Text="{DynamicResource S.Ramp.Title}"
                 FontSize="{StaticResource Text.Section}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Margin="0,0,14,0" />

      <ComboBox Grid.Column="1"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile}"
                MinWidth="170"
                VerticalAlignment="Center">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:RampProfile">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBox Grid.Column="2"
               Text="{Binding ProfileName, Mode=TwoWay}"
               Watermark="{DynamicResource S.Ramp.Profile.Name}"
               Width="170"
               Margin="8,0,0,0"
               VerticalAlignment="Center" />

      <Button Grid.Column="3"
              Theme="{StaticResource SecondaryButton}"
              Command="{Binding NewProfileCommand}"
              Margin="8,0,0,0"
              Padding="9,0"
              ToolTip.Tip="{DynamicResource S.Action.NewProfile}">
        <c:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" />
      </Button>

      <Button Grid.Column="4"
              Theme="{StaticResource SecondaryButton}"
              Command="{Binding DeleteProfileCommand}"
              Margin="6,0,0,0"
              Padding="9,0"
              ToolTip.Tip="{DynamicResource S.Action.DeleteProfile}">
        <c:Icon Data="{StaticResource Icon.Trash2}" Width="13" Height="13" />
      </Button>

      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12"
                  VerticalAlignment="Center" Margin="14,0,14,0">
        <TextBlock Text="{Binding TotalDurationText}"
                   Classes="sub"
                   FontFamily="{StaticResource Font.Mono}"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProfileMessage}"
                   Classes="sub"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Button Grid.Column="6"
              Theme="{StaticResource SecondaryButton}"
              Content="{DynamicResource S.Action.SaveProfile}"
              Command="{Binding SaveProfileCommand}"
              Margin="0,0,8,0" />

      <Button Grid.Column="7"
              Theme="{StaticResource PrimaryButton}"
              Content="{DynamicResource S.Action.StartRamp}"
              Command="{Binding StartRampCommand}" />
    </Grid>

    <!-- ============ Curve ============ -->
    <Border Grid.Row="1" Classes="card" Background="{DynamicResource Bg.Deep}" Padding="6">
      <c:RampCurveEditor Points="{Binding Points}"
                         HoldMinutes="{Binding HoldMinutes}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
    </Border>

    <!-- ============ Table · Inspector ============ -->
    <!-- ============ What the device cannot follow ============
         Under the curve and across the full width, because it is about the curve rather than about
         whichever point happens to be selected - and because a warning nobody scrolls to is not a
         warning. It is one, though, not a refusal: the figures behind it are measurements from one
         device in one room, and a climb drawn steeper than the device manages is a fair way of
         saying "as fast as you can". The falls are the ones worth reading. -->
    <TextBlock Grid.Row="2"
               Text="{Binding ReachabilityNote}"
               Classes="warn"
               Margin="2,10,2,0"
               IsVisible="{Binding ReachabilityNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid Grid.Row="3" ColumnDefinitions="*,12,300" Margin="0,12,0,0">

      <Border Grid.Column="0" Classes="card flush">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="28,76,76,*" Margin="14,12,14,8">
            <TextBlock Grid.Column="0" Classes="label" Text="{DynamicResource S.Ramp.Point}" />
            <TextBlock Grid.Column="1" Classes="label" Text="{DynamicResource S.Ramp.Time}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{DynamicResource S.Ramp.Temp}" />
            <TextBlock Grid.Column="3" Classes="label" Text="{DynamicResource S.Ramp.CurveToNext}" />
          </Grid>

          <ListBox Classes="rows"
                   ItemsSource="{Binding Points}"
                   SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RampPointViewModel">
                <Grid ColumnDefinitions="28,76,76,*" Height="34">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Number}"
                             FontFamily="{StaticResource Font.Mono}"
                             Foreground="{DynamicResource Text.Dim}"
                             VerticalAlignment="Center" />
                  <!-- The selected row turns into fields, so a value can be typed exactly rather
                       than only dragged into place. -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding TimeText}"
                             FontFamily="{StaticResource Font.Mono}"
                             IsVisible="{Binding !IsSelected}"
                             VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Theme="{StaticResource InlineField}"
                           Text="{Binding TimeMinutes, Mode=TwoWay}"
                           IsVisible="{Binding IsSelected}"
                           IsEnabled="{Binding Number, Converter={StaticResource IsNotFirstPoint}}" />

                  <TextBlock Grid.Column="2"
                             Text="{Binding TemperatureText}"
                             FontFamily="{StaticResource Font.Mono}"
                             Classes.invalid="{Binding HasError}"
                             IsVisible="{Binding !IsSelected}"
                             VerticalAlignment="Center" />
                  <TextBox Grid.Column="2"
                           Theme="{StaticResource InlineField}"
                           Text="{Binding Celsius, Mode=TwoWay}"
                           Classes.invalid="{Binding HasError}"
                           IsVisible="{Binding IsSelected}" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding CurveText}"
                             Foreground="{DynamicResource Text.Muted}"
                             IsVisible="{Binding !IsLast}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="label" Text="{Binding SegmentTitle}" />

          <ItemsControl ItemsSource="{Binding Curves}" IsEnabled="{Binding HasSegment}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CurveOptionViewModel">
                <ToggleButton Theme="{StaticResource Chip}"
                              Content="{Binding Name}"
                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Margin="0,0,6,6"
                              Command="{Binding $parent[ItemsControl].((vm:RampViewModel)DataContext).SetCurveCommand}"
                              CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Theme="{StaticResource SecondaryButton}"
                    Content="{DynamicResource S.Action.AddPoint}"
                    Command="{Binding AddPointCommand}" />
            <Button Theme="{StaticResource SecondaryButton}"
                    Content="{DynamicResource S.Action.Remove}"
                    Command="{Binding RemovePointCommand}" />
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource Border.Faint}" />

          <TextBlock Classes="label" Text="{DynamicResource S.Ramp.Hold}" />
          <c:Stepper Value="{Binding HoldMinutes, Mode=TwoWay}"
                     Minimum="0" Maximum="120" Step="1" Unit="min" />

          <TextBlock Text="{Binding ValidationMessage}"
                     Classes="error"
                     IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="{Binding WarmUpNote}"
                     Classes="sub"
                     TextWrapping="Wrap"
                     IsVisible="{Binding WarmUpNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="{DynamicResource S.Ramp.EditHint}"
                     Classes="sub"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>


</UserControl>
