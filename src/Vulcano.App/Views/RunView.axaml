<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vulcano.App.Controls"
             xmlns:vm="clr-namespace:Vulcano.App.ViewModels"
             x:Class="Vulcano.App.Views.RunView"
             x:DataType="vm:RunViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

    <!-- ============ The four numbers ============ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,12,*,12,*,12,*">

      <Border Grid.Column="0" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="MEASURED" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding MeasuredText}" Classes="big" />
            <TextBlock Text="°C" Classes="unit" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="PLAN NOW" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding PlanNowText}" Classes="big" />
            <Border Classes="chip" VerticalAlignment="Center">
              <TextBlock Text="{Binding DeltaText}" FontFamily="{StaticResource Font.Mono}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="4" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="TIME LEFT" />
          <TextBlock Text="{Binding TimeLeftText}" Classes="big" />
          <TextBlock Text="{Binding EndsAtText}" Classes="sub" />
        </StackPanel>
      </Border>

      <Border Grid.Column="6" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="SEGMENT" />
          <TextBlock Text="{Binding SegmentText}" Classes="big" />
          <TextBlock Text="{Binding SegmentDetail}" Classes="sub" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ The whole run as one strip ============ -->
    <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="label" Text="PROGRESS" />
          <TextBlock Grid.Column="2" Text="{Binding PhaseText}" Classes="sub" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Segments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Widths follow each segment's duration, so the strip is a picture of the run
                   rather than a row of equal boxes. -->
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RunSegmentViewModel">
              <Border Classes="segment"
                      Classes.active="{Binding IsActive}"
                      Classes.complete="{Binding IsComplete}">
                <TextBlock Text="{Binding Label}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ============ Device state ============ -->
    <Border Grid.Row="2" Classes="card" Margin="0,12,0,0" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" Spacing="20">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Data="{StaticResource Icon.Flame}"
                  Foreground="{DynamicResource Heat}"
                  IsVisible="{Binding IsHeaterOn}" />
          <TextBlock Text="Heater on" IsVisible="{Binding IsHeaterOn}" VerticalAlignment="Center" />
          <TextBlock Text="Heater off" Classes="sub" IsVisible="{Binding !IsHeaterOn}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Data="{StaticResource Icon.Fan}"
                  Foreground="{DynamicResource Text.Muted}"
                  IsVisible="{Binding IsPumpOn}" />
          <TextBlock Text="Pump on" IsVisible="{Binding IsPumpOn}" VerticalAlignment="Center" />
          <TextBlock Text="Pump off" Classes="sub" IsVisible="{Binding !IsPumpOn}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Auto shut-off is held off while the ramp runs" Classes="sub" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- ============ Actions ============ -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
      <Button Theme="{StaticResource SecondaryButton}"
              Content="{Binding PauseLabel}"
              Command="{Binding TogglePauseCommand}" />
      <Button Theme="{StaticResource SecondaryButton}"
              Content="Skip segment"
              Command="{Binding SkipSegmentCommand}" />
      <Button Theme="{StaticResource PrimaryButton}"
              Content="Stop ramp"
              Command="{Binding StopRampCommand}" />
    </StackPanel>
  </Grid>


</UserControl>
