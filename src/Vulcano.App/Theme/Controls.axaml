<!--
  Control themes. Fluent supplies everything not listed here; these are the handful of controls the
  design actually restyles, plus the small compound pieces (segment control, chips, pills) that
  appear often enough to deserve a name.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Vulcano.App.Controls"
                    xmlns:conv="clr-namespace:Vulcano.App.Converters">

  <!-- Declared here rather than in App.axaml because the templates below reach for them with
       StaticResource, which resolves within this dictionary. Merged into the application's
       resources along with everything else, so views can use them too. -->
  <conv:EnumToBoolConverter x:Key="EnumToBool" />
  <conv:WholeNumberConverter x:Key="WholeNumber" />
  <conv:IsNotFirstPointConverter x:Key="IsNotFirstPoint" />
  <conv:DimWhenTrueConverter x:Key="DimWhenTrue" />

  <ControlTheme x:Key="{x:Type controls:Icon}" TargetType="controls:Icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <!-- The canvas pins the 24x24 grid the geometries were drawn on, so icons with
               different bounding boxes still line up with each other. -->
          <Canvas Width="24" Height="24">
            <Path Data="{TemplateBinding Data}"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="{TemplateBinding StrokeThickness}"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- "– 195 +". The number is mono with tabular figures so the field does not twitch as the
       value changes width. -->
  <ControlTheme x:Key="{x:Type controls:Stepper}" TargetType="controls:Stepper">
    <Setter Property="Height" Value="{StaticResource Size.Field}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Bg.Field}"
                BorderBrush="{DynamicResource Border.Strong}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Field}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Name="PART_Decrease"
                    Grid.Column="0"
                    Theme="{StaticResource StepperButton}"
                    Content="–" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Value, Converter={StaticResource WholeNumber}}"
                         FontFamily="{StaticResource Font.Mono}"
                         FontSize="{StaticResource Text.Body}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource Text}" />
              <TextBlock Text="{TemplateBinding Unit}"
                         FontFamily="{StaticResource Font.Mono}"
                         FontSize="{StaticResource Text.Small}"
                         Foreground="{DynamicResource Text.Dim}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Button Name="PART_Increase"
                    Grid.Column="2"
                    Theme="{StaticResource StepperButton}"
                    Content="+" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The 5 px bar under the live temperature. Heat on the left, accent on the right, so the
       colour itself says how close the device is. -->
  <ControlTheme x:Key="ThinProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="5" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Bg.Field}" CornerRadius="999" ClipToBounds="True">
          <Panel Name="PART_ContainerGrid" HorizontalAlignment="Stretch">
            <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="999">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="{DynamicResource Color.Heat}" />
                  <GradientStop Offset="1" Color="{DynamicResource Color.Accent}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The editable cell in the ramp table: a field only where the row is active, sized to sit
       inside a 34 px row without pushing it around. -->
  <ControlTheme x:Key="InlineField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style Selector="^.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="StepperButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
  </ControlTheme>

  <!-- Primary action: accent fill, dark text on it. One per view, at most. -->
  <ControlTheme x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.On}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
    <Setter Property="Height" Value="{StaticResource Size.Field}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- Everything else that is still a real button: field-coloured with a border. -->
  <ControlTheme x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
    <Setter Property="Height" Value="{StaticResource Size.Field}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Text.Faint}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- Toolbar buttons: no chrome until hovered. Icon plus label, per the design's rule that no
       icon ever appears without its word next to it. -->
  <ControlTheme x:Key="GhostButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
    <Setter Property="Height" Value="{StaticResource Size.Field}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- Minimise / maximise / close, 44 x 40 each, flush to the window's top right corner. -->
  <ControlTheme x:Key="WindowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="{StaticResource Size.TitleBar}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource Error}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </ControlTheme>

  <!-- The compact window's title bar is 26 px, so its two buttons are too. -->
  <ControlTheme x:Key="CompactWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
  </ControlTheme>

  <!--
    A title-bar button that stays pressed, for always-on-top in the compact window. Same 28 x 26 as
    the buttons beside it, so the bar keeps its rhythm; checked is carried by the accent colour
    rather than a filled background, because at this size a filled square next to two flat icons
    reads as a different kind of control rather than as the same one switched on.
  -->
  <ControlTheme x:Key="CompactWindowToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="^:checked:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
  </ControlTheme>

  <!-- 34 x 34 icon tiles in the compact window: heater, pump. Checked means "on", and with
       Classes="heat" that reads as warm rather than as merely selected. -->
  <ControlTheme x:Key="CompactTile" TargetType="ToggleButton">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource Surface.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="^.heat:checked">
      <Setter Property="Background" Value="{DynamicResource Surface.Heat}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Heat}" />
      <Setter Property="Foreground" Value="{DynamicResource Heat}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CompactButton" TargetType="Button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
      <Setter Property="Foreground" Value="{DynamicResource Error.Text}" />
    </Style>
  </ControlTheme>

  <!-- One tab of the Control / Ramp / Run segment control. Active is an accent fill. -->
  <ControlTheme x:Key="SegmentButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.On}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </ControlTheme>

  <!-- Quick-select temperature chips and the curve chips in the ramp inspector. -->
  <ControlTheme x:Key="Chip" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Sub}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Height" Value="{StaticResource Size.Field}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{StaticResource Text.Small}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource Surface.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
  </ControlTheme>

  <!--
    38 x 22 track, 16 x 16 knob, 3 px inset - the design's numbers, not Fluent's.
    Built on ToggleButton rather than ToggleSwitch: ToggleSwitch requires named template parts it
    animates itself (PART_MovingKnobs and friends), and this switch is a track with a knob in it,
    with nothing for that machinery to do.
  -->
  <ControlTheme x:Key="Toggle" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Track"
                Width="38" Height="22"
                Background="{DynamicResource Bg.Field}"
                BorderBrush="{DynamicResource Border.Strong}"
                BorderThickness="1"
                CornerRadius="999">
          <Ellipse x:Name="Knob"
                   Width="16" Height="16"
                   Margin="2,0,0,0"
                   HorizontalAlignment="Left"
                   Fill="{DynamicResource Toggle.Knob}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#Knob">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Fill" Value="{DynamicResource Accent.On}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Field}" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Surface.Accent}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel Margin="{TemplateBinding Padding}">
            <TextBlock Text="{TemplateBinding Watermark}"
                       Foreground="{DynamicResource Text.Faint}"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            <TextPresenter Name="PART_TextPresenter"
                           Text="{TemplateBinding Text, Mode=TwoWay}"
                           CaretBrush="{TemplateBinding CaretBrush}"
                           SelectionBrush="{TemplateBinding SelectionBrush}"
                           SelectionStart="{TemplateBinding SelectionStart}"
                           SelectionEnd="{TemplateBinding SelectionEnd}"
                           VerticalAlignment="Center" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
