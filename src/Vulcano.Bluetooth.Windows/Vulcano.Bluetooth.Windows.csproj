<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinRT BLE adapter. Referenced from Vulcano.App only on Windows RIDs; the BlueZ sibling
       takes its place on Linux. Both implement IVolcanoTransport from Vulcano.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Vulcano.Bluetooth.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vulcano.Core\Vulcano.Core.csproj" />
  </ItemGroup>

</Project>
