<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-free core: models, ramp maths, BLE encoding, settings, log, relay protocol.
       No UI, no WinRT, no D-Bus - everything OS-specific lives behind IVolcanoTransport. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vulcano.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- No generated designer class: the keys are dotted (Tab.Control), which a generated property
         name cannot be, and the dots are what makes them line up with the design document. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.de.resx">
      <Generator></Generator>
    </EmbeddedResource>

    <!-- The changelog ships inside the assembly rather than beside it: the app updates itself in
         the background, and notes that travel with the binary are the only ones guaranteed to
         describe the version actually running. Linked from the repository root so there is one
         file, readable on GitHub and by the app. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Vulcano.Core.CHANGELOG.md" />
  </ItemGroup>

</Project>
