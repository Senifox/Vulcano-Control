<Window x:Class="Vulcano_Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vulcano_Control"
        xmlns:converters="clr-namespace:Vulcano_Control.Converters"
        xmlns:models="clr-namespace:Vulcano_Control.Models"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Vulcano Control" Height="1000" Width="700"
        Icon="Icon.ico"
        Topmost="{Binding IsAlwaysOnTop}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NoValidationErrorsConverter x:Key="NoValidationErrorsConverter"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#FFFF9800"/>
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF808080"/>

        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Shows a tooltip with the validation error (e.g. the valid temperature range) instead
             of silently correcting the textbox's content - relies on ObservableValidator's
             [Range] attributes on the bound properties for the actual validation. -->
        <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="-16,-16,-16,16">
            <MenuItem Header="_Ansicht">
                <MenuItem Header="Heller Modus" IsCheckable="True"
                          IsChecked="{Binding IsLightMode, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="{x:Static models:AppTheme.Light}"/>
                <MenuItem Header="Dunkler Modus" IsCheckable="True"
                          IsChecked="{Binding IsDarkMode, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="{x:Static models:AppTheme.Dark}"/>
                <Separator/>
                <MenuItem Header="Diagramm anzeigen" IsCheckable="True"
                          IsChecked="{Binding IsChartVisible}"/>
                <MenuItem Header="Protokoll anzeigen" IsCheckable="True"
                          IsChecked="{Binding IsLogWindowVisible}"/>
                <Separator/>
                <MenuItem Header="Immer im Vordergrund" IsCheckable="True"
                          IsChecked="{Binding IsAlwaysOnTop}"/>
            </MenuItem>
            <MenuItem Header="_Optionen">
                <MenuItem Header="Programmeinstellungen..." Command="{Binding OpenProgramSettingsCommand}"/>
                <MenuItem Header="Vulcano-Einstellungen..." Command="{Binding OpenDeviceSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="Nach Updates suchen" Command="{Binding CheckForUpdatesCommand}"/>
            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Verbinden" Command="{Binding ConnectCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Trennen" Command="{Binding DisconnectCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16"
                    IsEnabled="{Binding IsConnected}">
            <TextBlock Text="Aktuelle Temperatur: " VerticalAlignment="Center" FontSize="18"/>
            <TextBlock Text="{Binding CurrentTemperatureDisplay}" FontSize="24" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,16"
                    IsEnabled="{Binding IsConnected}">
            <TextBlock Text="Zieltemperatur: " VerticalAlignment="Center"/>
            <!-- Validation.ErrorTemplate is suppressed here on purpose: the slider's own Minimum/
                 Maximum already make it impossible for the user to drag it into an invalid value,
                 so showing the red error adorner on it too (it shares the same bound property as
                 the textbox below) would be misleading rather than helpful. -->
            <Slider Minimum="40" Maximum="230" Width="220" VerticalAlignment="Center"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Validation.ErrorTemplate="{x:Null}"
                    Value="{Binding TargetTemperature, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox x:Name="TargetTemperatureTextBox"
                     Text="{Binding TargetTemperature, UpdateSourceTrigger=LostFocus}"
                     Style="{StaticResource ValidatedTextBoxStyle}"
                     Width="90" VerticalAlignment="Center" Margin="8,0"/>
            <Button Content="Setzen" Command="{Binding ApplyTargetTemperatureCommand}" Padding="12,4">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource NoValidationErrorsConverter}">
                        <Binding ElementName="TargetTemperatureTextBox" Path="(Validation.HasError)"/>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,16"
                    IsEnabled="{Binding IsConnected}">
            <ToggleButton Content="Heizung" IsChecked="{Binding IsHeaterOn, Mode=OneWay}"
                          Command="{Binding ToggleHeaterCommand}" Padding="16,8" Margin="0,0,8,0"/>
            <ToggleButton Content="Pumpe" IsChecked="{Binding IsPumpOn, Mode=OneWay}"
                          Command="{Binding TogglePumpCommand}" Padding="16,8"/>
            <TextBlock Text="{Binding RemainingAutoOffTimeSpan, StringFormat=Automatische Abschaltung in: {0:mm\\:ss}}"
                       VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding IsAutoOffCountingDown, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Separator Grid.Row="6" Margin="0,0,0,16"/>

        <GroupBox Grid.Row="7" Header="Temperatur-Rampe" Margin="0,0,0,16" Padding="8"
                  IsEnabled="{Binding IsConnected}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Dauer (min): " VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="RampDurationTextBox"
                             Text="{Binding RampDurationMinutes, UpdateSourceTrigger=LostFocus}" Width="90"
                             Style="{StaticResource ValidatedTextBoxStyle}"
                             IsEnabled="{Binding IsRampRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Start-Temp (°C): " VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="RampStartTemperatureTextBox"
                             Text="{Binding RampStartTemperature, UpdateSourceTrigger=LostFocus}" Width="90"
                             Style="{StaticResource ValidatedTextBoxStyle}"
                             IsEnabled="{Binding IsRampRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Ziel-Temp (°C): " VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="RampEndTemperatureTextBox"
                             Text="{Binding RampEndTemperature, UpdateSourceTrigger=LostFocus}" Width="90"
                             Style="{StaticResource ValidatedTextBoxStyle}"
                             IsEnabled="{Binding IsRampRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Verlauf: " VerticalAlignment="Center" Width="130"/>
                    <ComboBox ItemsSource="{Binding InterpolationMethods}" SelectedItem="{Binding RampInterpolationMethod}" Width="140"
                              IsEnabled="{Binding IsRampRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Nachlaufzeit (min): " VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="RampHoldMinutesTextBox"
                             Text="{Binding RampHoldMinutes, UpdateSourceTrigger=LostFocus}" Width="90"
                             Style="{StaticResource ValidatedTextBoxStyle}"
                             IsEnabled="{Binding IsRampRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Button Content="Rampe starten" Command="{Binding StartRampCommand}" Padding="12,4" Margin="0,0,8,0">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource NoValidationErrorsConverter}">
                                <Binding ElementName="RampDurationTextBox" Path="(Validation.HasError)"/>
                                <Binding ElementName="RampStartTemperatureTextBox" Path="(Validation.HasError)"/>
                                <Binding ElementName="RampEndTemperatureTextBox" Path="(Validation.HasError)"/>
                                <Binding ElementName="RampHoldMinutesTextBox" Path="(Validation.HasError)"/>
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Rampe stoppen" Command="{Binding StopRampCommand}" Padding="12,4"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsRampRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Heize auf Start-Temperatur auf…" FontStyle="Italic" Margin="0,0,0,4"
                               Visibility="{Binding IsRampWarmingUp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="Halte Endtemperatur (Nachlaufzeit)…" FontStyle="Italic" Margin="0,0,0,4"
                               Visibility="{Binding IsRampHolding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding RampFractionComplete, Mode=OneWay}" Height="16" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding RampRemaining, StringFormat=Restzeit: {0:mm\\:ss}}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding RampCurrentTarget, StringFormat=Ziel gerade: {0} °C}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="8" Margin="0,0,0,16" Padding="8"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Visibility="{Binding IsChartVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  IsEnabled="{Binding IsConnected}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rampen-Diagramm" VerticalAlignment="Center"/>
                    <Button Content="Ansicht zurücksetzen" Command="{Binding ResetChartViewCommand}"
                            Padding="8,2" Margin="12,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>
            <oxy:PlotView Model="{Binding RampPlotModel}" MinHeight="200" Foreground="Black"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <!-- Reproduces OxyPlot's own default tracker template (PlotViewBase in
                     OxyPlot.Wpf's Generic.xaml) verbatim, only adding an explicit Foreground on
                     the TextBlock. Without it, the app-wide implicit TextBlock style in
                     Themes/ControlStyles.xaml (Win10 fallback dark theme) overrides the tracker's
                     text to a light color, unreadable against its fixed pale-yellow background. -->
                <oxy:PlotView.DefaultTrackerTemplate>
                    <ControlTemplate>
                        <oxy:TrackerControl Position="{Binding Position}" LineExtents="{Binding PlotModel.PlotArea}">
                            <oxy:TrackerControl.Content>
                                <TextBlock Text="{Binding}" Margin="7" Foreground="Black"/>
                            </oxy:TrackerControl.Content>
                        </oxy:TrackerControl>
                    </ControlTemplate>
                </oxy:PlotView.DefaultTrackerTemplate>
            </oxy:PlotView>
        </GroupBox>

        <Separator Grid.Row="9" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="10" Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}"
                   VerticalAlignment="Bottom" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="10" Text="{Binding AppVersionDisplay}" Foreground="{StaticResource SecondaryTextBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
    </Grid>
</Window>
