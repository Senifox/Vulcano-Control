<Window x:Class="Vulcano_Control.NetworkJoinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Mit Server verbinden" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Icon.ico">
    <StackPanel Margin="16">
        <TextBlock Text="Verbindet dich mit einem bereits laufenden LAN-Server einer anderen Vulcano-Control-Instanz." TextWrapping="Wrap"/>

        <TextBlock Text="Server-Adresse:" Margin="0,16,0,0"/>
        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

        <TextBlock Text="Port:" Margin="0,16,0,0"/>
        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

        <TextBlock Text="PIN:" Margin="0,16,0,0"/>
        <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Verbinden" Command="{Binding ConnectCommand}" Padding="12,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Padding="12,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
