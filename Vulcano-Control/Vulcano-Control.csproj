<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Vulcano_Control</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <!-- Velopack needs VelopackApp.Build().Run() to run as the literal first line of Main(),
         before any WPF overhead - so App.xaml.cs defines its own Main() instead of relying on
         the WPF-generated one, which requires App.xaml to compile as a Page rather than the
         ApplicationDefinition. -->
    <StartupObject>Vulcano_Control.App</StartupObject>
    <!-- The rewrite manages package versions centrally from the repo root; this project keeps its
         own inline versions until it is removed. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- MediaPlayer (unlike Image/Icon) can't load pack://application:,,, resources - it only
         understands pack://siteoforigin:,,, URIs, which resolve to files next to the exe. So
         these ship as plain Content copied to the output directory instead of embedded Resources. -->
    <Content Include="Sounds\Heat-Reached.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Sounds\Shutdown.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
