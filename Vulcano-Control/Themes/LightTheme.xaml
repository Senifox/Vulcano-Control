<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF9A9A9A"/>

    <!-- Classic (non-Fluent) WPF control templates - the ones actually used on Windows 10 -
         pull their chrome colors (menu popups, ComboBox dropdown, Slider track/thumb,
         GroupBox bevel) from these SystemColors resource keys directly, which plain Style
         Setters on the control types above cannot reach. Overriding them here re-themes
         that chrome too. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFE65100"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
</ResourceDictionary>
