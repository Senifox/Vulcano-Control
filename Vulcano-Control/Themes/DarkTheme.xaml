<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF808080"/>

    <!-- Classic (non-Fluent) WPF control templates - the ones actually used on Windows 10 -
         pull their chrome colors (menu popups, ComboBox dropdown, Slider track/thumb,
         GroupBox bevel) from these SystemColors resource keys directly, which plain Style
         Setters on the control types above cannot reach. Overriding them here re-themes
         that chrome too. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF808080"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF808080"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFFF9800"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1E1E1E"/>
</ResourceDictionary>
