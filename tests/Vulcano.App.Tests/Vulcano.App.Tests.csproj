<Project Sdk="Microsoft.NET.Sdk">

  <!-- The view models, tested. They were the largest piece of the app with no tests at all, and the
       bug that made that expensive - a point inserted behind the view model's back, so nothing
       revalidated - lived exactly here.

       The Windows target framework is inherited from what Vulcano.App is: the app project references
       the WinRT adapter, so anything referencing it has to agree. Nothing in these tests touches
       Bluetooth. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vulcano.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vulcano.App\Vulcano.App.csproj" />
    <ProjectReference Include="..\Vulcano.TestSupport\Vulcano.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Vulcano.TestSupport" />
  </ItemGroup>

</Project>
